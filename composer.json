{
	"name": "getkirby/getkirby.com",
	"description": "The entire getkirby.com website",
	"type": "project",
	"homepage": "https://getkirby.com",
	"require": {
		"php": ">=8.2.0",
		"getkirby/cms": "^4.0"
	},
	"scripts": {
		"start": [
			"Composer\\Config::disableProcessTimeout",
			"@php -S localhost:8181 kirby/router.php"
		],
		"fix": "cpx getkirby/php-cs:^0.2 fix",
		"test": "@composer --working-dir=site/plugins/site run test"
	},
	"config": {
		"optimize-autoloader": true
	}
}
