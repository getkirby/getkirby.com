{
	"name": "getkirby/site",
	"autoload": {
		"psr-4": {
			"Kirby\\": "src/"
		}
	},
	"require": {
		"caxy/php-htmldiff": "^0.1.15",
		"phpstan/phpdoc-parser": "^2.3.6"
	},
	"config": {
		"optimize-autoloader": true
	},
	"scripts": {
		"test": "cpx brianium/paratest:7.20.0",
		"test:coverage": "XDEBUG_MODE=coverage cpx brianium/paratest:7.20.0 --coverage-html=tests/coverage"
	}
}
