#!/usr/bin/env php
<?php

use Kirby\Data\PHP;
use Kirby\Http\Remote;

/**
 * Usage: generate-ppp-factors [out-filename]
 *
 * `out-filename`: Optional PHP file path to write the generated factors to
 *                 (otherwise printed to stdout as a PHP array)
 */

require_once dirname(__DIR__, 4) . '/kirby/bootstrap.php';

$factors = [];

// go back at most three years and fill up the factors, starting with the
// most recent year (the previous year looking from today)
for ($year = (int)date('Y') - 1; $year > (int)date('Y') - 4; $year--) {
	$data = worldBankRequestLoop($year);

	// find the German factor for this year to use it as a baseline
	$countries   = array_column($data, 'countryiso3code');
	$baselineKey = array_search('DEU', $countries) ?: throw new Exception("Could not find baseline for $year");
	$baseline    = $data[$baselineKey];

	foreach ($data as $entry) {
		// skip countries we already have a (more recent) factor for
		if (array_key_exists($entry['country']['id'], $factors)) {
			continue;
		}

		// skip countries that don't (yet) have a factor for the given year
		if ($entry['value'] === null) {
			continue;
		}

		// values in the dataset are relative to US prices,
		// we need to adjust them to German prices by comparing
		// to the German PPP factor of the same statistical year
		$factor = $entry['value'] / $baseline['value'];

		// only keep the lowest-PPP countries
		if ($factor > 0.6) {
			continue;
		}

		$factors[$entry['country']['id']] = $factor;
	}
}

// sort by country code
ksort($factors);

// export to a PHP array
if (empty($argv[1]) === false) {
	PHP::write($argv[1], $factors);
} else {
	echo PHP::encode($factors);
}

/**
 * Performs requests to the World Bank API with exponential backoff
 * until one succeeds (the API often times out or returns temporary
 * errors that are fixed with another identical request)
 */
function worldBankRequestLoop(int $year): array
{
	for ($i = 0; $i <= 5; $i++) {
		try {
			return worldBankRequest($year);
		} catch (Throwable $e) {
			// give up after five tries
			if ($i > 4) {
				throw $e;
			}

			$delay = match ($i) {
				0 => 5,
				1 => 10,
				2 => 20,
				3 => 60,
				4 => 120
			};

			fwrite(STDERR, "Received API error for request $year, sleeping for $delay seconds:\n$e\n");

			sleep($delay);
		}
	}
}

/**
 * Requests the PPP factors from the World Bank API
 * Docs see https://datahelpdesk.worldbank.org/knowledgebase/articles/898581-api-basic-call-structures
 * and https://datahelpdesk.worldbank.org/knowledgebase/articles/898599-indicator-api-queries
 */
function worldBankRequest(int $year): array
{
	$response = Remote::get(
		"https://api.worldbank.org/v2/country/all/indicator/PA.NUS.PPPC.RF?format=json&date=$year&per_page=500",
		['timeout' => 60]
	);

	// some errors are not properly handled by the API and
	// return a HTML page with HTTP 400
	if ($response->code() !== 200) {
		throw new Exception('Received HTTP ' . $response->code());
	}

	$content = $response->json();

	// errors are returned as a HTTP 200 response with a message key in the first object
	if (count($content) === 1 && isset($content[0]['message']) === true) {
		throw new Exception('Response error ' . $content[0]['message'][0]['id'] . ': ' . $content[0]['message'][0]['value']);
	}

	[$meta, $data] = $content;

	// a page size of 500 should be enough; if it isn't, something is going wrong
	if ($meta['pages'] > 1) {
		throw new Exception("Too many results for request $year: " . $meta['total']);
	}

	return $data;
}
